    {
        "id": "425cc8d066f77d21",
        "type": "function",
        "z": "a23a6dbcbcc19732",
        "name": "preparar_telemetria",
        "func": "const rows = msg.payload;\nconst step = 20;                         // 1 em cada 20 linhas (~900 pontos)\nconst out = { speed: [], rpm: [], throttle: [], gear: [] };\nconst parse = (s) => Date.parse(String(s).replace(' ', 'T').replace(/(\\.\\d{3})\\d*/, '$1'));\nlet t0 = null, vmax = 0;\n\nfor (let i = 0; i < rows.length; i++) {\n  const r = rows[i];\n  if (!r || !r.date) continue;\n  const t = parse(r.date);\n  if (isNaN(t)) continue;\n  if (t0 === null) t0 = t;               // início da sessão\n  const v = Number(r.speed);\n  if (v > vmax) vmax = v;\n  if (i % step !== 0) continue;\n  const x = t;\n  out.speed.push({ x: x, y: v });\n  out.rpm.push({ x: x, y: Number(r.rpm) });\n  out.throttle.push({ x: x, y: Number(r.throttle) });\n  out.gear.push({ x: x, y: Number(r.n_gear) });\n}\n\nreturn [\n  { topic: 'Velocidade (km/h)', payload: out.speed },\n  { topic: 'Rotações (rpm)',    payload: out.rpm },\n  { topic: 'Acelerador (%)',    payload: out.throttle },\n  { topic: 'Mudança',           payload: out.gear },\n  { topic: 'Velocidade máxima', payload: vmax }\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
